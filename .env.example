APP_NAME=SMP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Endereço desta API (local: php artisan serve --port=8025)
APP_URL=http://localhost:8025
# Endereço do frontend React (CORS, redirects do Google, links)
FRONTEND_URL=http://localhost:5173
# Opcional: várias origens permitidas separadas por vírgula (por omissão = FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://smp-frontend.onrender.com

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL + PostGIS
# Local:
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smp
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# Neon (produção): basta DB_URL (substitui host/porta/base/utilizador/palavra-passe)
# DB_URL=postgresql://utilizador:palavra-passe@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DB_SSLMODE=require

# A API usa tokens (Sanctum); sessões não são necessárias
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OpenStreetMap
OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_DEFAULT_LAT=-25.9692
OSM_DEFAULT_LNG=32.4539
OSM_DEFAULT_ZOOM=13

# Rotas (OpenRouteService)
OPENROUTESERVICE_API_KEY=

# API interna (integrações externas)
INTERNAL_API_ENABLED=false
INTERNAL_API_ALLOWED_IPS=127.0.0.1
INTERNAL_API_RATE_LIMIT=100
INTERNAL_API_RATE_LIMIT_DECAY=1
INTERNAL_API_TOKEN_EXPIRY_DAYS=90

# Google OAuth (login de cidadãos)
# O callback agora é na API: <APP_URL>/api/auth/google/callback
# (registar este URL na Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8025/api/auth/google/callback
